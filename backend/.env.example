# Address the backend binds to.
BIND_ADDR=0.0.0.0:8080

# Database. REQUIRED, and the scheme must be explicit:
#   libsql://<db>.turso.io   remote Turso (needs TURSO_AUTH_TOKEN)
#   file:recipes.db          local
# A bare path is refused deliberately. It used to be accepted, which let a
# placeholder reach production and silently open a database inside the
# container — healthy-looking, and gone on restart.
DATABASE_URL=file:recipes.db
# Turso WRITE token — required only for a remote libsql:// URL. Keep secret.
TURSO_AUTH_TOKEN=

# Log filter (tracing EnvFilter syntax).
RUST_LOG=recipe_backend=debug,tower_http=info,info

# --- Telegram auth (#25) -----------------------------------------------------
# Auth is MANDATORY: every endpoint requires a session, so the backend refuses to
# start without all three of these. A backend that cannot mint a login can serve
# nothing, and failing at startup beats failing on the first request.

# From @BotFather. A backend secret, handled like TURSO_AUTH_TOKEN — it must
# never reach the browser. Keep out of git.
TELEGRAM_BOT_TOKEN=

# Where the bot's completion link points, e.g. https://recipes.lehlehleh.com.
# The bot sends an absolute URL, so the backend has to know the site.
FRONTEND_BASE_URL=

# A random secret you choose, registered with setWebhook and echoed back by
# Telegram in X-Telegram-Bot-Api-Secret-Token. NOT optional: the webhook URL is
# public, so without this anyone can POST a forged `/start` claiming any Telegram
# id — i.e. log in as anybody. Generate one:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
TELEGRAM_WEBHOOK_SECRET=

# --- The operator ------------------------------------------------------------
# The admin's NUMERIC Telegram id — never a username, which can be released and
# reclaimed by somebody else. Find yours in GET /api/me while signed in.
#
# It does two jobs, and they are the same person by construction. It gates the
# admin health dashboard (/api/admin/health), and it is where the run alarm (#183)
# sends its message: in a one-to-one chat the chat id IS the user id, so the person
# who can see the dashboard is already an address the bot may write to. Being the
# admin means having messaged the bot — that is how the session was minted — which
# is what makes the message deliverable at all (a bot cannot open a conversation).
#
# Optional, like INGEST_API_KEY and unlike the secrets above: unset, admin views
# 403 for everyone and the run check logs its alarm instead of sending it. It never
# stops the service, and it is never a broadcast — one id, or nobody.
ADMIN_TELEGRAM_USER_ID=

# --- Session cookie -----------------------------------------------------------
# Parent domain BOTH services share, e.g. lehlehleh.com, so recipes.<domain> and
# api.recipes.<domain> see one cookie. That is what makes a SameSite=Lax cookie
# reach the #20 WebSocket: same registrable domain = same site.
#
# It is also why a custom domain is needed at all. onrender.com is on the Public
# Suffix List, so two *.onrender.com subdomains are different SITES and browsers
# reject a Domain of it outright.
#
# UNSET in dev: the cookie is then scoped to the host that set it, which is all
# plain http on localhost needs.
COOKIE_DOMAIN=

# `true` anywhere reachable; `false` ONLY for local http. Required, and stated
# rather than inferred from COOKIE_DOMAIN: a forgotten variable that silently
# puts a session on the wire unprotected is not a failure anyone notices.
COOKIE_SECURE=

# The frontend origin, e.g. https://recipes.lehlehleh.com. Comma-separate for
# more than one. NOT a security control — CORS is browser-enforced and curl
# ignores it; the session check is the guard. It must be explicit anyway because
# a credentialed request may not be answered with `Access-Control-Allow-Origin: *`,
# so leaving it unset in prod would stop the browser sending the cookie at all.
# Unset = dev (mirror the caller's origin).
CORS_ALLOWED_ORIGIN=

# Point Telegram at the deployed webhook (once, after deploy):
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://<backend-host>/api/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
